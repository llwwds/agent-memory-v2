# agent-memory-v2 deployment env template (sanitized; real .env lives ONLY in
# the device-local deployment dir, e.g. ~/llwwds_application/docker_file/memos/.env,
# with 0600 perms and never enters git/docs/logs).

## Base
TZ=Asia/Shanghai
MOS_TEXT_MEM_TYPE=tree_text          # /product API is tree-text based
ASYNC_MODE=sync                      # sync add path for M0; async extraction lands with the pipeline
MOS_ENABLE_DEFAULT_CUBE_CONFIG=true

## Chat / extraction LLM via own OpenAI-compatible gateway
MOS_CHAT_MODEL=<model-name>          # e.g. gemini-3.8-flash-high
MOS_CHAT_TEMPERATURE=0.4
MOS_MAX_TOKENS=4096
OPENAI_API_KEY=<gateway-token>       # from secret store (macOS Keychain), never committed
OPENAI_API_BASE=http://host.docker.internal:3000/v1
MEMRADER_MODEL=<model-name>
MEMRADER_API_KEY=<gateway-token>
MEMRADER_API_BASE=http://host.docker.internal:3000/v1

## Embedding: local ollama container serving bge-m3 (1024-dim, official-sample pick)
MOS_EMBEDDER_BACKEND=ollama
OLLAMA_API_BASE=http://ollama:11434
MOS_EMBEDDER_MODEL=bge-m3
EMBEDDING_DIMENSION=1024

## Reranker: local cosine fallback (external bge-reranker service optional later)
MOS_RERANKER_BACKEND=cosine_local

## Graph / vector stores (compose-internal service names)
NEO4J_BACKEND=neo4j-community
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<neo4j-password>      # must match compose NEO4J_AUTH
NEO4J_DB_NAME=neo4j                  # community edition: default db only
NEO4J_AUTO_CREATE=false
NEO4J_USE_MULTI_DB=false
QDRANT_HOST=qdrant
QDRANT_PORT=6333

## Feature switches (M0 scope)
ENABLE_PREFERENCE_MEMORY=false       # upstream pref_mem needs Milvus; M1 revisits via extraction pipeline
ENABLE_INTERNET=false
SEARCH_MODE=fast

## API auth for /product (B3 fix) — shared by memos API and the MCP bridge
MEMOS_API_KEY=<random-64hex>
